# Keep the credentialed RPC only in a local or server-side environment file.
RPC_HTTP_URL=https://your-robinhood-chain-rpc.example/redacted
RPC_WSS_URL=wss://your-robinhood-chain-rpc.example/redacted

CHAIN_ID=4663
OPERATION_MODE=shadow
LIVE_BROADCAST_ENABLED=false

# Set this to the verified deployment block before a full backfill.
BACKFILL_FROM_BLOCK=0
EVENT_CHUNK_BLOCKS=2000
SHADOW_MAX_POSITIONS=100
SHADOW_CONCURRENCY=5
BULK_TOKEN_CHUNK=200
DATA_DIR=./data

# Zero means there is no live authorization. Do not change these casually.
MAX_GAS_NATIVE_WEI=0
MAX_FAILED_GAS_NATIVE_WEI=0
MIN_NET_PROFIT_NATIVE_WEI=0
MAX_DAILY_LOSS_NATIVE_WEI=0
AUTHORIZATION_EXPIRES_AT=

# Optional. Defaults outside the repository under ~/.config.
# KEYSTORE_PATH=/absolute/path/to/pools-trade-keeper.keystore.json
