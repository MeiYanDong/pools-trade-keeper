{
  "name": "pools-trade-fee-compounding-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first shadow keeper for Pools.trade fee compounding on Robinhood Chain.",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "biome format --write src tests scripts fixtures docs/*.json package.json tsconfig.json vitest.config.ts biome.json",
    "format:check": "biome format src tests scripts fixtures docs/*.json package.json tsconfig.json vitest.config.ts biome.json",
    "lint": "biome lint --error-on-warnings src tests scripts",
    "test": "vitest run",
    "deploy:lint": "bash -n deploy/*.sh",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "release:check": "node scripts/write-release-manifest.mjs --check",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "verify": "npm run sniper:validate && npm run secrets:scan && npm run format:check && npm run lint && npm run typecheck && npm test && npm run deploy:lint && npm run build && npm run release:manifest && npm run release:check",
    "sniper:validate": "tsx scripts/validate-sniper-spec.ts --spec docs/sniper-spec.json",
    "doctor": "tsx src/cli.ts doctor",
    "snapshot": "tsx src/cli.ts snapshot",
    "quote-candidate": "tsx src/cli.ts quote-candidate",
    "backfill": "tsx src/cli.ts backfill",
    "deployment-block": "tsx src/cli.ts deployment-block",
    "inventory-start": "tsx src/cli.ts inventory-start",
    "shadow": "tsx src/cli.ts shadow",
    "bulk-shadow": "tsx src/cli.ts bulk-shadow",
    "replay": "tsx src/cli.ts replay",
    "capabilities": "tsx src/cli.ts capabilities",
    "rpc:init": "tsx src/rpc-cli.ts init",
    "wallet:init": "tsx src/wallet-cli.ts init",
    "wallet:address": "tsx src/wallet-cli.ts address"
  },
  "dependencies": {
    "viem": "2.55.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.3.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
